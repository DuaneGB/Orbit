# Copy to .env.local for `vercel dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# --- Required: database (Neon Postgres) ---
# Set automatically when Neon is connected through Vercel → Storage.
# Server only; never prefix with VITE_. Orbit creates its tables on first use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Recommended: stop strangers creating workspaces on your URL ---
# Anyone creating a new workspace must enter this key. Leave empty to allow anyone.
ORBIT_SETUP_KEY=

# --- Hosted apps: list your Vercel projects and their live links ---
# Vercel → Account Settings → Tokens. Scope it to the team that owns the projects.
VERCEL_TOKEN=
# Team ID (Vercel → Team Settings → General). Leave empty for a personal account.
VERCEL_TEAM_ID=
# Team URL slug, used for "open in Vercel" links.
VERCEL_TEAM_SLUG=

# --- Optional: browser push notifications (npx web-push generate-vapid-keys) ---
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Optional: Google Calendar two-way sync ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-ORBIT-DOMAIN/api/google/callback
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# At least 32 random characters.
GOOGLE_OAUTH_STATE_SECRET=
